# ==============================================================================
# Enterprise Policy QA Assistant - Environment Configuration
# Copy this file to '.env' and fill in your respective API keys.
# ==============================================================================

# --- Primary LLM Provider (Groq Free Tier) ---
# Sign up and generate a free API key at https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Fallback LLM Provider (Google Gemini Free Tier) ---
# Sign up and generate an API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- Optional Secondary Fallback (OpenRouter) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- LangSmith Observability & Tracing (Optional) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_key_here
LANGCHAIN_PROJECT=iima-policy-qa-assistant
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Local Vector & Retrieval Engine Configuration (100% Free / Local CPU) ---
STORAGE_DIR=storage
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2
CALIBRATED_SUFFICIENCY_THRESHOLD=0.03
